{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oriented-a2a.local/schema/experience-packet.schema.json",
  "title": "ExperiencePacket",
  "type": "object",
  "required": ["id", "type", "content", "absorption"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["failure_mode", "strategy_fragment", "tool_trajectory", "other"] },
    "content": { "type": "object" },
    "absorption": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": [
            "prompt_injection",
            "retrieval",
            "local_adapter_hint",
            "trajectory_replay",
            "parameter_delta",
            "other"
          ],
          "description": "MUST support prompt_injection and retrieval. OPTIONAL: local_adapter_hint, trajectory_replay. RESERVED/optional: parameter_delta (receivers without support MUST reject)."
        },
        "target": { "type": "string" },
        "hint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "expiry": { "type": "object" },
    "prior_outcomes": {
      "type": "object",
      "properties": {
        "absorbed_count": { "type": "integer", "minimum": 0 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "last_status": { "enum": ["absorbed", "rejected", "isolated", "none"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_ref"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "chain": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "verification_claim": {
      "type": "object",
      "required": ["expected_effect"],
      "properties": {
        "expected_effect": { "type": "string", "minLength": 1 },
        "replay_hint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
    },
    "nonce": { "type": "string", "minLength": 1 },
    "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
    "signature": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
