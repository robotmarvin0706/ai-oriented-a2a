{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oriented-a2a.local/schema/agent-profile.schema.json",
  "title": "AgentProfile",
  "type": "object",
  "required": ["constraints", "improvement_prefs", "shareable_types"],
  "properties": {
    "constraints": { "type": "array", "items": { "type": "string" } },
    "improvement_prefs": { "type": "array", "items": { "type": "string" } },
    "shareable_types": { "type": "array", "items": { "type": "string" } },
    "interest_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional light broadcast interest tags for discovery; peers MAY ignore unknown tags."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
    },
    "nonce": { "type": "string", "minLength": 1 },
    "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
    "signature": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "alg": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Optional identity binding (public-key fingerprint or opaque identifier). When present, fingerprint is required."
    }
  },
  "additionalProperties": false
}
