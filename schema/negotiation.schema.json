{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oriented-a2a.local/schema/negotiation.schema.json",
  "title": "NegotiationMessage",
  "oneOf": [
    {
      "type": "object",
      "required": ["proposal_id", "target_constraint", "proposed_change"],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "target_constraint": { "type": "string" },
        "proposed_change": { "type": "string" },
        "offered_packet": { "$ref": "experience-packet.schema.json" },
        "conditional_packet": { "$ref": "experience-packet.schema.json" },
        "constraint_scope": { "type": "string" },
        "duration": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
        },
        "nonce": { "type": "string", "minLength": 1 },
        "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
        "signature": {
          "type": "object",
          "required": ["alg", "value"],
          "properties": {
            "alg": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["proposal_id"],
      "properties": {
        "proposal_id": { "type": "string" },
        "status": { "const": "accept" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
        },
        "nonce": { "type": "string", "minLength": 1 },
        "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
        "signature": {
          "type": "object",
          "required": ["alg", "value"],
          "properties": {
            "alg": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["proposal_id"],
      "properties": {
        "proposal_id": { "type": "string" },
        "status": { "const": "reject" },
        "reason": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
        },
        "nonce": { "type": "string", "minLength": 1 },
        "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
        "signature": {
          "type": "object",
          "required": ["alg", "value"],
          "properties": {
            "alg": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["proposal_id", "revised_change"],
      "properties": {
        "proposal_id": { "type": "string" },
        "status": { "const": "counter" },
        "revised_change": { "type": "string" },
        "offered_packet": { "$ref": "experience-packet.schema.json" },
        "conditional_packet": { "$ref": "experience-packet.schema.json" },
        "constraint_scope": { "type": "string" },
        "duration": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
        },
        "nonce": { "type": "string", "minLength": 1 },
        "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
        "signature": {
          "type": "object",
          "required": ["alg", "value"],
          "properties": {
            "alg": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
