{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oriented-a2a.local/schema/absorption-result.schema.json",
  "title": "AbsorptionResult",
  "type": "object",
  "required": ["packet_ref", "status"],
  "properties": {
    "packet_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["absorbed", "rejected", "isolated"] },
    "reason": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "effect_summary": {
      "type": "object",
      "required": ["note"],
      "properties": {
        "note": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean"]
          }
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Optional on-wire protocol version. Canonical value is \"0.3\". Values with a leading v (e.g. \"v0.3\") are treated as unknown and MUST be rejected."
    },
    "nonce": { "type": "string", "minLength": 1 },
    "timestamp": { "oneOf": [{ "type": "number" }, { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }] },
    "signature": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "absorbed" } },
        "required": ["status"]
      },
      "then": { "required": ["effect_summary"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["rejected", "isolated"] } },
        "required": ["status"]
      },
      "then": { "required": ["reason"] }
    }
  ],
  "additionalProperties": false
}
