{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oriented-a2a.local/schema/absorption-result.schema.json",
  "title": "AbsorptionResult",
  "type": "object",
  "required": ["packet_ref", "status"],
  "properties": {
    "packet_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["absorbed", "rejected", "isolated"] },
    "reason": { "type": "string", "minLength": 1 },
    "effect_summary": {
      "type": "object",
      "required": ["note"],
      "properties": {
        "note": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "absorbed" } },
        "required": ["status"]
      },
      "then": { "required": ["effect_summary"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["rejected", "isolated"] } },
        "required": ["status"]
      },
      "then": { "required": ["reason"] }
    }
  ],
  "additionalProperties": false
}
